{
  "name": "gcp-compute",
  "platform": "activate.parallel.works",
  "user": "alvaro",
  "workflow_name": "ollama",
  "workflow": {
    "repo": "github.com/parallelworks/workflows",
    "path": "workflows/ollama/yamls/general.yaml",
    "ref": "canary"
  },
  "timeout_s": 3000,
  "warm_marker": [
    "${HOME}/pw/software/ollama-gguf/bin/ollama",
    "${HOME}/pw/software/ollama-gguf/models"
  ],
  "leftover_patterns": [
    "ollama",
    "pw endpoints run"
  ],
  "inputs": {
    "cluster": {
      "resource": "pw://alvaro/gcpsmall",
      "scheduler": true,
      "slurm": {
        "is_enabled": true,
        "partition": "compute",
        "time": "00:30:00",
        "scheduler_directives": "#SBATCH --comment=cpu-only-test"
      }
    },
    "service": {
      "name": "ollama-gguf",
      "models": "huggingface.co/bartowski/Qwen2.5-0.5B-Instruct-GGUF:Q4_K_M",
      "context_length": "4096",
      "preload": true
    }
  }
}
