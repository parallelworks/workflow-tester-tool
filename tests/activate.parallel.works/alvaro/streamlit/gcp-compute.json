{
  "name": "gcp-compute",
  "platform": "activate.parallel.works",
  "user": "alvaro",
  "workflow_name": "streamlit",
  "workflow": {
    "repo": "github.com/parallelworks/workflows",
    "path": "workflows/streamlit/yamls/general.yaml",
    "ref": "canary"
  },
  "timeout_s": 2400,
  "warm_marker": "${HOME}/pw/software/containers/ghcr.io_parallelworks_streamlit_1.0/streamlit.sif",
  "leftover_patterns": [
    "streamlit",
    "pw endpoints run"
  ],
  "inputs": {
    "cluster": {
      "resource": "pw://alvaro/gcpsmall",
      "scheduler": true,
      "slurm": {
        "is_enabled": true,
        "partition": "compute",
        "time": "00:30:00"
      }
    },
    "service": {
      "registry": "ghcr.io/parallelworks/streamlit:1.0"
    }
  }
}
