{
  "name": "gcp-controller",
  "platform": "activate.parallel.works",
  "user": "alvaro",
  "workflow_name": "lite-agent",
  "workflow": {
    "repo": "github.com/parallelworks/workflows",
    "path": "workflows/lite-agent/yamls/general.yaml",
    "ref": "canary"
  },
  "timeout_s": 1200,
  "warm_marker": "${HOME}/pw/software/agent-venv",
  "leftover_patterns": [
    "agent_server",
    "pw endpoints run"
  ],
  "inputs": {
    "cluster": {
      "resource": "pw://alvaro/gcpsmall",
      "scheduler": false
    },
    "service": {
      "model": "org:glm/glm-5.1",
      "allocation": "Owners"
    }
  }
}
